{
  "name": "ifay-umbrella-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "iFay umbrella specification, authoritative FayManifest schema, official @ifay/sdk, and @ifay/ifacts conformance harness",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages/ifay-sdk/tests/ifay-sdk.test.mjs packages/ifacts-harness/tests/ifacts-harness.test.mjs && node schema/faymanifest/generator/validate-fixtures.mjs",
    "ifacts:self-test": "node packages/ifacts-harness/bin/ifacts.mjs --self-test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
